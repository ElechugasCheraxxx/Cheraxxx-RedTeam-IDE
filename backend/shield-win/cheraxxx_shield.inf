[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = cheraxxx_shield.cat
DriverVer   = 05/20/2024,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
cheraxxx_shield.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
%cheraxxx_shield.DeviceDesc% = cheraxxx_shield_Device, Root\cheraxxx_shield

[cheraxxx_shield_Device.NT]
CopyFiles = File_Copy

[File_Copy]
cheraxxx_shield.sys

[cheraxxx_shield_Device.NT.Services]
AddService = cheraxxx_shield,%SPSVCINST_ASSOCSERVICE%,cheraxxx_shield_Service

[cheraxxx_shield_Service]
DisplayName    = %cheraxxx_shield.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 1               ; SERVICE_SYSTEM_START (Vanguard-style boot start)
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\cheraxxx_shield.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "Cheraxxx Sovereignty"
DiskName = "Cheraxxx Shield Installation Disk"
cheraxxx_shield.DeviceDesc = "Cheraxxx Shield Kernel Guard"
cheraxxx_shield.SVCDESC = "Cheraxxx Shield Service"
